# Base path of the backend API as seen by the browser. Keep "/api" in development
# (Vite proxies it to VITE_PROXY_TARGET).
VITE_API_BASE_URL=/api
# Where the Vite dev server forwards /api requests.
# Use 127.0.0.1, not localhost: Node resolves localhost to IPv6 (::1), uvicorn binds IPv4.
VITE_PROXY_TARGET=http://127.0.0.1:8000
