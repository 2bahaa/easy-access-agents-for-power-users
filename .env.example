# Copy to .env and adjust. Used by docker-compose and the backend.

# --- PostgreSQL ---
POSTGRES_USER=eaa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eaa
POSTGRES_PORT=5432

# --- Backend ---
# Async SQLAlchemy URL (asyncpg driver). Use 127.0.0.1, not localhost: the db port is
# published on IPv4 only, and on Windows an IPv6 (::1) attempt first costs ~2 s per connection.
DATABASE_URL=postgresql+asyncpg://eaa:change-me@127.0.0.1:5432/eaa
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Root folder the file_reader tool may read from (never outside it)
WORKSPACE_DIR=../workspace
# Global hard caps (agents may set lower values, never higher)
MAX_TOOL_CALLS_CAP=20
RUN_TIMEOUT_CAP_S=300
TOOL_TIMEOUT_S=10
CORS_ORIGINS=http://localhost:5173

# --- Docker (full stack: docker compose up -d --build) ---
# Host ports (bound to 127.0.0.1). UI: http://localhost:3000, API docs: http://localhost:8001/docs
FRONTEND_PORT=3000
BACKEND_PORT=8001
# How the backend container reaches Ollama on the host.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Tests ---
# Optional. Defaults to the DATABASE_URL database name + "_test".
# WARNING: this database is dropped and recreated on every test run.
# TEST_DATABASE_URL=postgresql+asyncpg://eaa:change-me@127.0.0.1:5432/eaa_test
