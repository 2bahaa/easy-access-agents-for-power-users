# Copy to .env and adjust. Used by docker-compose and the backend.

# --- PostgreSQL ---
POSTGRES_USER=eaa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eaa
POSTGRES_PORT=5432

# --- Backend ---
# Async SQLAlchemy URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://eaa:change-me@localhost:5432/eaa
OLLAMA_BASE_URL=http://localhost:11434
# Root folder the file_reader tool may read from (never outside it)
WORKSPACE_DIR=../workspace
# Global hard caps (agents may set lower values, never higher)
MAX_TOOL_CALLS_CAP=20
RUN_TIMEOUT_CAP_S=300
TOOL_TIMEOUT_S=10
CORS_ORIGINS=http://localhost:5173

# --- Tests ---
# Optional. Defaults to the DATABASE_URL database name + "_test".
# WARNING: this database is dropped and recreated on every test run.
# TEST_DATABASE_URL=postgresql+asyncpg://eaa:change-me@localhost:5432/eaa_test
